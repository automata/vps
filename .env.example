# Hetzner Cloud
HETZNER_TOKEN=

# OVHcloud
OVH_ENDPOINT=ovh-eu
OVH_SUBSIDIARY=GB
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Contabo
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=

# Optional: use upgrade candidates from one existing instance as a price/spec reference.
# This is NOT guaranteed to equal Contabo new-order pricing and excludes the current product.
CONTABO_PRICE_REFERENCE_INSTANCE_ID=

# Optional alternative: a JSON array you maintain with normalized Contabo prices.
# CONTABO_PRICE_CATALOG_JSON=/absolute/path/to/contabo-prices.json
